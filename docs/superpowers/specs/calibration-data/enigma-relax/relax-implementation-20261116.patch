+# tests/test_ai_enigma_relax.py
+"""難解＋の「余裕外し」（enigma*plus_relax_*・実測 calibration-data/enigma-relax/）のテスト（KataGo/Kivy 不要）。
+
+大差の勝勢で、選択が最善手に倒れた手番（Best move wins the confusion race）だけ、9段らしく・ほぼ損のない別の手へ
+外して終局レポートの一致率を下げる。罠の手番（Deviate）には触れない。既定 OFF＝従来とビット同一。
+"""
+
+import types
+
+import pytest
+
+from katrain.core.ai import (
+    ENIGMA9_RELAX_HP_RATIO,
+    ENIGMA9_RELAX_MIN_WR,
+    ENIGMA9_RELAX_SLACK,
+    Enigma9PlusStrategy,
+    Enigma9Strategy,
+    Enigma13PlusStrategy,
+    Enigma13Strategy,
+    Enigma19PlusStrategy,
+    Enigma19Strategy,
+    EnigmaPlusMixin,
+    enigma9_relax_pick,
+)
+from katrain.core.sgf_parser import Move
+
+BASES = (Enigma9Strategy, Enigma13Strategy, Enigma19Strategy)
+PLUS = (Enigma9PlusStrategy, Enigma13PlusStrategy, Enigma19PlusStrategy)
+
+
+def row(gtp, loss, own_hp, e, wr_after=0.999):
+    return {"gtp": gtp, "loss": loss, "own_hp": own_hp, "e": e, "wr_after": wr_after}
+
+
+BEST = row("D4", 0.0, 0.5, 1.0)
+
+
+def pick(rows, *, lead=30.0, min_lead=12.0, max_loss=1.0, min_hp=0.1, max_e_drop=0.5, **kw):
+    return enigma9_relax_pick([BEST] + rows, "D4", lead, min_lead, max_loss, min_hp, max_e_drop, **kw)
+
+
+def gtp_of(result):
+    return None if result[0] is None else result[0]["gtp"]
+
+
+class TestConstants:
+    def test_values(self):
+        assert (ENIGMA9_RELAX_MIN_WR, ENIGMA9_RELAX_SLACK, ENIGMA9_RELAX_HP_RATIO) == (0.97, 0.3, 0.25)
+
+    def test_plus_defaults_are_off(self):
+        d = EnigmaPlusMixin.PLUS_DEFAULTS
+        assert d["relax_min_lead"] == 0.0
+        assert (d["relax_max_loss"], d["relax_min_hp"], d["relax_max_e_drop"]) == (1.0, 0.1, 0.5)
+
+    def test_base_enigma_has_no_relax_settings(self):
+        for cls in BASES:
+            assert not any(k.startswith("relax") for k in cls.SETTING_DEFAULTS), cls.__name__
+
+
+class TestRelaxPick:
+    def test_off_when_min_lead_is_zero_or_none(self):
+        rows = [row("K10", 0.0, 0.4, 1.0)]
+        assert pick(rows, min_lead=0.0) == (None, [])
+        assert pick(rows, min_lead=None) == (None, [])
+
+    def test_failsafe_without_best_entry_or_lead(self):
+        rows = [row("K10", 0.0, 0.4, 1.0)]
+        assert enigma9_relax_pick(rows, "D4", 30.0, 12.0, 1.0, 0.1, 0.5) == (None, [])
+        assert pick(rows, lead=None) == (None, [])
+
+    def test_natural_cheap_move_is_picked(self):
+        result = pick([row("K10", 0.4, 0.3, 0.8)])
+        assert gtp_of(result) == "K10"
+        assert [c["gtp"] for c in result[1]] == ["K10"]
+
+    def test_loss_cap(self):
+        assert gtp_of(pick([row("K10", 1.01, 0.3, 1.0)])) is None
+        assert gtp_of(pick([row("K10", 1.0, 0.3, 1.0)])) == "K10"  # 境界は含む
+        assert gtp_of(pick([row("K10", 1.4, 0.3, 1.0)], max_loss=1.5)) == "K10"
+
+    def test_human_policy_floor(self):
+        assert gtp_of(pick([row("K10", 0.1, 0.09, 1.0)], hp_ratio=0.0)) is None
+        assert gtp_of(pick([row("K10", 0.1, 0.10, 1.0)], hp_ratio=0.0)) == "K10"
+
+    def test_floor_scales_with_the_best_move_policy(self):
+        # 最善手が hp 0.5 → 比の床 0.125。hp 0.9 の一手なら床 0.225＝hp 0.2 の手には替えない
+        assert gtp_of(pick([row("K10", 0.1, 0.12, 1.0)])) is None
+        assert gtp_of(pick([row("K10", 0.1, 0.13, 1.0)])) == "K10"
+        obvious = row("D4", 0.0, 0.9, 1.0)
+        assert enigma9_relax_pick([obvious, row("K10", 0.1, 0.2, 1.0)], "D4", 30.0, 12.0, 1.0, 0.1, 0.5)[0] is None
+        assert (
+            enigma9_relax_pick([obvious, row("K10", 0.1, 0.23, 1.0)], "D4", 30.0, 12.0, 1.0, 0.1, 0.5)[0]["gtp"]
+            == "K10"
+        )
+
+    def test_winrate_floor(self):
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 1.0, wr_after=0.96)])) is None
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 1.0, wr_after=None)])) is None
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 1.0, wr_after=0.97)])) == "K10"
+
+    def test_lead_after_the_swap_must_stay_above_the_floor(self):
+        assert gtp_of(pick([row("K10", 0.5, 0.3, 1.0)], lead=12.4)) is None  # 12.4 − 0.5 < 12
+        assert gtp_of(pick([row("K10", 0.5, 0.3, 1.0)], lead=12.5)) == "K10"
+
+    def test_trap_guard_keeps_a_best_move_that_is_itself_the_trap(self):
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 0.4)])) is None  # E 1.0 → 0.4 は 0.5 を超える低下
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 0.5)])) == "K10"
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 0.4)], max_e_drop=99.0)) == "K10"
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 0.99)], max_e_drop=0.0)) is None
+        assert gtp_of(pick([row("K10", 0.1, 0.3, 1.2)], max_e_drop=0.0)) == "K10"
+
+    def test_most_natural_move_within_the_cheapest_band(self):
+        rows = [row("K10", 0.0, 0.2, 1.0), row("H8", 0.3, 0.4, 1.0), row("G7", 0.9, 0.45, 1.0)]
+        result = pick(rows)
+        assert gtp_of(result) == "H8"  # G7 は最安 0.0 から 0.3 目の帯の外
+        assert [c["gtp"] for c in result[1]] == ["K10", "H8", "G7"]
+
+    def test_negative_verified_loss_counts_as_free(self):
+        # 検証で最善手より良かった手（loss < 0）は代金 0。帯の基準も 0
+        rows = [row("K10", -0.8, 0.2, 1.0), row("H8", 0.2, 0.4, 1.0)]
+        assert gtp_of(pick(rows)) == "H8"
+        assert gtp_of(pick([row("K10", -0.8, 0.2, 1.0)], lead=11.5)) == "K10"  # 11.5 + 0.8 >= 12
+
+    def test_tie_on_policy_prefers_the_cheaper_move(self):
+        assert gtp_of(pick([row("K10", 0.2, 0.3, 1.0), row("H8", 0.1, 0.3, 1.0)])) == "H8"
+
+    def test_pass_and_best_are_never_picked(self):
+        assert gtp_of(pick([row("pass", 0.0, 0.9, 1.0)])) is None
+
+
+def _stub(cls, settings=None):
+    logs = []
+    katrain_ns = types.SimpleNamespace(log=lambda msg, *a, **k: logs.append(str(msg)))
+    node = types.SimpleNamespace(next_player="B")
+    game = types.SimpleNamespace(katrain=katrain_ns, current_node=node)
+    return cls(game, settings or {}), logs
+
+
+class TestRelaxHook:
+    ROWS = [BEST, row("K10", 0.4, 0.3, 0.8)]
+
+    def test_base_hook_is_a_noop(self):
+        for cls in BASES:
+            s, logs = _stub(cls, {f"{cls.KEY_PREFIX}_relax_min_lead": 12.0})
+            assert s._relax_swap(self.ROWS, "D4", 30.0, 2.0, 8.0) is None
+            assert not any("Relax" in m for m in logs)
+
+    @pytest.mark.parametrize("cls", PLUS, ids=[c.KEY_PREFIX for c in PLUS])
+    def test_plus_default_is_off(self, cls):
+        s, logs = _stub(cls)
+        assert s._relax_swap(self.ROWS, "D4", 30.0, 2.0, 8.0) is None
+        assert not any("Relax" in m for m in logs)
+
+    @pytest.mark.parametrize("cls", PLUS, ids=[c.KEY_PREFIX for c in PLUS])
+    def test_plus_on_picks_and_logs(self, cls):
+        s, logs = _stub(cls, {f"{cls.KEY_PREFIX}_relax_min_lead": 12.0})
+        assert s._relax_swap(self.ROWS, "D4", 30.0, 2.0, 8.0)["gtp"] == "K10"
+        assert any("Relax: played K10" in m and "instead of D4" in m for m in logs)
+
+    def test_floor_never_drops_below_target_plus_large_cap(self):
+        # スライダー 8 でも target 2 + large_cap 10 = 12 が下限（外した後も消費モードの cap が上限のまま）
+        s, logs = _stub(Enigma13PlusStrategy, {"enigma13plus_relax_min_lead": 8.0})
+        assert s._relax_swap(self.ROWS, "D4", 11.9, 2.0, 10.0) is None
+        assert not any("Relax" in m for m in logs)
+        assert s._relax_swap(self.ROWS, "D4", 12.3, 2.0, 10.0) is None  # 12.3 − 0.4 < 12
+        assert s._relax_swap(self.ROWS, "D4", 12.4, 2.0, 10.0)["gtp"] == "K10"
+
+    def test_settings_are_passed_through(self):
+        on = {"enigma13plus_relax_min_lead": 12.0}
+        s, _ = _stub(Enigma13PlusStrategy, {**on, "enigma13plus_relax_max_loss": 0.3})
+        assert s._relax_swap(self.ROWS, "D4", 30.0, 2.0, 8.0) is None
+        s, _ = _stub(Enigma13PlusStrategy, {**on, "enigma13plus_relax_min_hp": 0.35})
+        assert s._relax_swap(self.ROWS, "D4", 30.0, 2.0, 8.0) is None
+        s, _ = _stub(Enigma13PlusStrategy, {**on, "enigma13plus_relax_max_e_drop": 0.0})
+        assert s._relax_swap(self.ROWS, "D4", 30.0, 2.0, 8.0) is None
+
+
+def _hp(size, values):
+    arr = [0.0] * (size * size + 1)
+    for gtp, v in values.items():
+        x, y = Move.from_gtp(gtp).coords
+        arr[(size - 1 - y) * size + x] = v
+    return arr
+
+
+def _child(lead_after, wr_after, replies, reply_hp, size=13):
+    """黒番が打った後の子局面プローブ（clean + hp）。replies は [(gtp, 白視点の損失, visits)]。"""
+    move_infos = [
+        {"move": g, "scoreLead": lead_after + loss, "visits": v, "order": i} for i, (g, loss, v) in enumerate(replies)
+    ]
+    return {
+        "clean": {"rootInfo": {"scoreLead": lead_after, "winrate": wr_after}, "moveInfos": move_infos},
+        "hp": {"humanPolicy": _hp(size, reply_hp)},
+    }
+
+
+def _replies(punish):
+    """正解 C3（hp 50%）と自然な失着 M12（hp 50%・punish 目損）＝ E = punish / 2。"""
+    return [("C3", 0.0, 300), ("M12", punish, 40)], {"C3": 0.5, "M12": 0.5}
+
+
+EASY = ([("C3", 0.0, 300), ("N1", 0.4, 20)], {"C3": 0.9, "N1": 0.05})  # 応手が自明＝E≈0
+
+
+def _strategy(cls, prefix, settings=None, *, lead=30.0, k10_punish=1.6, k10_hp=0.3, endgame=False):
+    """黒が大差で勝っている 13路・黒番（target 2・max_loss 1.6・large 8 → 消費モード cap 8）。
+
+    D4=最善（hp 50%・E 1.0）/ K10=検証済み 0.4 目損・hp 30%・E = k10_punish/2（既定 0.8＝最善手より低い＝
+    従来は最善手に倒れる）/ H8=0.2 目損だが hp 1%（珍しい手）。
+    """
+    logs = []
+    katrain_ns = types.SimpleNamespace(log=lambda msg, *a, **k: logs.append(str(msg)))
+    cands = [
+        {"move": "D4", "pointsLost": 0.0, "relativePointsLost": 0.0, "visits": 900, "winrate": 0.999},
+        {"move": "H8", "pointsLost": 0.2, "relativePointsLost": 0.2, "visits": 60, "winrate": 0.999},
+        {"move": "K10", "pointsLost": 0.3, "relativePointsLost": 0.3, "visits": 60, "winrate": 0.999},
+    ]
+    node = types.SimpleNamespace(
+        next_player="B",
+        player="W",
+        depth=60,
+        move=None,
+        analysis_complete=True,
+        analysis={"root": {"scoreLead": lead}},
+        candidate_moves=cands,
+    )
+    game = types.SimpleNamespace(katrain=katrain_ns, current_node=node, board_size=(13, 13))
+    if endgame:
+        setattr(game, f"_{prefix}_endgame", True)
+    base = {
+        f"{prefix}_opening_humanstyle_moves": 0,
+        f"{prefix}_max_loss": 1.6,
+        f"{prefix}_large_lead_max_loss": 8.0,
+        f"{prefix}_target_score": 2.0,
+        f"{prefix}_locality_stddev": 0.0,
+    }
+    s = cls(game, {**base, **(settings or {})})
+    s.probed = []
+
+    def probe(gtps, player, parent_hp=False):
+        s.probed.append(list(gtps))
+        table = {
+            "D4": _child(lead, 0.999, *_replies(2.0)),
+            "K10": _child(lead - 0.4, 0.999, *_replies(k10_punish)),
+            "H8": _child(lead - 0.2, 0.999, *EASY),
+        }
+        parent = {"humanPolicy": _hp(13, {"D4": 0.5, "K10": k10_hp, "H8": 0.01})} if parent_hp else None
+        return {g: table[g] for g in gtps}, parent
+
+    s._probe_children = probe
+    s._run_query = lambda label, **kw: {"ownership": [1.0] * 169, "rootInfo": {"scoreLead": lead}}
+    return s, logs
+
+
+ON = {"enigma13plus_relax_min_lead": 12.0}
+
+
+class TestRelaxEndToEnd:
+    def test_off_plays_the_best_move(self):
+        s, logs = _strategy(Enigma13PlusStrategy, "enigma13plus")
+        move, thoughts = s.generate_move()
+        assert move.gtp() == "D4"
+        assert "most confusing" in thoughts
+        assert any("Best move wins the confusion race" in m for m in logs)
+        assert not any("Relax" in m for m in logs)
+
+    def test_on_swaps_the_best_move_for_the_natural_cheap_move(self):
+        s, logs = _strategy(Enigma13PlusStrategy, "enigma13plus", ON)
+        move, thoughts = s.generate_move()
+        assert move.gtp() == "K10"
+        assert "relaxed to K10" in thoughts and "instead of D4" in thoughts
+        assert any("Relax: played K10" in m for m in logs)
+        assert not any("Best move wins the confusion race" in m for m in logs)
+
+    def test_on_issues_exactly_the_same_probes_as_off(self):
+        off, _ = _strategy(Enigma13PlusStrategy, "enigma13plus")
+        on, _ = _strategy(Enigma13PlusStrategy, "enigma13plus", ON)
+        off.generate_move()
+        on.generate_move()
+        assert on.probed == off.probed
+
+    def test_not_far_enough_ahead(self):
+        s, logs = _strategy(Enigma13PlusStrategy, "enigma13plus", ON, lead=11.0)
+        assert s.generate_move()[0].gtp() == "D4"
+        assert not any("Relax: played" in m for m in logs)
+
+    def test_trap_turn_is_untouched(self):
+        # K10 が本物の罠（E 3.0 > 最善手 1.0）なら従来どおり罠として打つ＝余裕外しは呼ばれない
+        for settings in ({}, ON):
+            s, logs = _strategy(Enigma13PlusStrategy, "enigma13plus", settings, k10_punish=6.0)
+            move, thoughts = s.generate_move()
+            assert move.gtp() == "K10"
+            assert "deviated to K10" in thoughts
+            assert any("Deviate: played K10" in m for m in logs)
+            assert not any("Relax" in m for m in logs)
+
+    def test_trap_guard_keeps_the_best_move(self):
+        s, logs = _strategy(Enigma13PlusStrategy, "enigma13plus", ON, k10_punish=0.8)  # E 0.4 = 0.6 目の低下
+        assert s.generate_move()[0].gtp() == "D4"
+        assert any("Relax:" in m and "qualifiers=[]" in m for m in logs)
+        relaxed = {**ON, "enigma13plus_relax_max_e_drop": 99.0}
+        s, _ = _strategy(Enigma13PlusStrategy, "enigma13plus", relaxed, k10_punish=0.8)
+        assert s.generate_move()[0].gtp() == "K10"
+
+    def test_unnatural_move_is_not_a_swap_target(self):
+        s, _ = _strategy(Enigma13PlusStrategy, "enigma13plus", ON, k10_hp=0.05)
+        assert s.generate_move()[0].gtp() == "D4"
+
+    def test_works_in_the_endgame_too(self):
+        off, _ = _strategy(Enigma13PlusStrategy, "enigma13plus", endgame=True)
+        assert off.generate_move()[0].gtp() == "D4"
+        on, logs = _strategy(Enigma13PlusStrategy, "enigma13plus", ON, endgame=True)
+        assert on.generate_move()[0].gtp() == "K10"
+        assert any("Relax: played K10" in m for m in logs)
+
+    def test_base_enigma_ignores_the_setting(self):
+        s, logs = _strategy(Enigma13Strategy, "enigma13", {"enigma13_relax_min_lead": 12.0})
+        assert s.generate_move()[0].gtp() == "D4"
+        assert not any("Relax" in m for m in logs)
