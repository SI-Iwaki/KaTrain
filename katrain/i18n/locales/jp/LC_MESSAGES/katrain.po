msgstr "[9路] 1手あたり損失上限（目）"

msgid "enigma9_large_lead_max_loss"
msgstr "[9路] 勝勢時の勝負手損失上限（目）"

msgid "enigma9_min_winrate"
msgstr "[9路] 着手後の勝率フロア"

msgid "enigma9_net_margin"
msgstr "[9路] 外しに要求する難解さの差"

msgid "enigma9_target_score"
msgstr "[9路] ヨセの目標差（目）"

msgid "enigma9_aim_jigo"
msgstr "[9路] 持碁〜2目以内の負け狙い"

msgid "enigma9_endgame_move"
msgstr "[9路] ヨセ切替手数"

msgid "enigma9_unsettled_max"
msgstr "[9路] ヨセ判定の未確定点上限"

msgid "enigma9_locality_stddev"
msgstr "[9路] 局所性（意外さの有効半径・OFF=従来）"

